# Small focused binary; does not link the browser UI implementation.
test("arc_routing_tests") {
  sources = [
    "arc_question_routing.cc",
    "arc_question_routing_unittest.cc",
  ]
  deps = [
    ":arc_native_swift",
    "//base",
    "//base/test:run_all_unittests",
    "//chrome/browser/ui:arc_routing_headers",
    "//components/favicon/content",
    "//components/omnibox/browser",
    "//net",
    "//testing/gtest",
    "//third_party/icu",
    "//url",
  ]
}

# Swift support is confined to these UI files; C++ toolchain inputs stay intact.
action("arc_native_swift") {
  script = "compile_arc_swift.py"
  sources = [ "arc_native_ui.swift" ]
  outputs = [
    "$target_gen_dir/arc_native_swift.o",
    "$target_gen_dir/arc_native_swift.h",
  ]
  args = [
    "--source",
    rebase_path(sources[0], root_build_dir),
    "--output",
    rebase_path(outputs[0], root_build_dir),
    "--header",
    rebase_path(outputs[1], root_build_dir),
    "--sdk",
    rebase_path(mac_sdk_path, root_build_dir),
    "--arch",
    current_cpu,
  ]
}
