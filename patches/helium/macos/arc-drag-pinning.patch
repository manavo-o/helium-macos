   base::WeakPtr<TabDragController> ref(weak_factory_.GetWeakPtr());
   DragState previous_state = current_state_;
+  // Change pinning after native drag teardown, so cancellation retains the
+  // original model and the drag controller never holds reparented tab views.
+  if (type == EndDragType::kNormal &&
+      previous_state == DragState::kDraggingTabs && attached_context_ &&
+      drag_data_.dragging_groups.empty()) {
+    auto* browser_view = BrowserView::GetBrowserViewForNativeWindow(
+        attached_context_->GetWidget()->GetNativeWindow());
+    if (browser_view && browser_view->ShouldDrawVerticalTabStrip()) {
+      auto* region = browser_view->vertical_tab_strip_region_view_for_testing();
+      auto* unpinned = region ? region->GetUnpinnedTabsContainer() : nullptr;
+      if (unpinned &&
+          region->GetBoundsInScreen().Contains(last_point_in_screen_)) {
+        const int boundary =
+            unpinned->GetBoundsInScreen().y() +
+            GetLayoutConstant(LayoutConstant::kVerticalTabHeight) / 2;
+        const bool pin = last_point_in_screen_.y() < boundary;
+        std::vector<base::WeakPtr<content::WebContents>> tabs;
+        for (const auto& data : drag_data_.tab_drag_data_) {
+          if (data.contents && data.pinned != pin) {
+            tabs.push_back(data.contents->GetWeakPtr());
+          }
+        }
+        if (!tabs.empty()) {
+          base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+              FROM_HERE,
+              base::BindOnce(
+                  [](base::WeakPtr<BrowserWindowInterface> browser,
+                     std::vector<base::WeakPtr<content::WebContents>> tabs,
+                     bool pin) {
+                    if (!browser) {
+                      return;
+                    }
+                    auto* model = browser->GetTabStripModel();
+                    for (const auto& contents : tabs) {
+                      const int index =
+                          contents
+                              ? model->GetIndexOfWebContents(contents.get())
+                              : TabStripModel::kNoTab;
+                      if (index != TabStripModel::kNoTab &&
+                          model->IsTabPinned(index) != pin) {
+                        model->SetTabPinned(index, pin);
+                      }
+                    }
+                  },
+                  browser_view->browser()->GetWeakPtr(), std::move(tabs), pin));
+        }
+      }
+    }
+  }
