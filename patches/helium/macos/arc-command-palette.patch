+namespace {
+
+constexpr int kBarWidth = 820;
+constexpr int kCornerRadius = 16;
+constexpr int kMaxResults = 5;
+constexpr std::array<std::u16string_view, 27> kQuestionWords = {
+    u"who",   u"what",  u"when",  u"where", u"why",   u"how",  u"which",
+    u"whose", u"whom",  u"is",    u"are",   u"am",    u"was",  u"were",
+    u"do",    u"does",  u"did",   u"can",   u"could", u"should",
+    u"would", u"will",  u"has",   u"have",  u"had",   u"may",  u"might"};
+
+bool IsWordCharacter(char16_t c) {
+  return (c >= u'a' && c <= u'z') || (c >= u'A' && c <= u'Z') ||
+         (c >= u'0' && c <= u'9') || c == u'_';
+}
+
+bool LooksLikeQuestion(std::u16string_view input) {
+  const std::u16string trimmed(base::TrimWhitespace(input, base::TRIM_ALL));
+  if (trimmed.find(u'?') != std::u16string::npos) {
+    return true;
+  }
+  for (std::u16string_view word : kQuestionWords) {
+    if (trimmed.size() < word.size()) {
+      continue;
+    }
+    bool equal = true;
+    for (size_t i = 0; i < word.size(); ++i) {
+      char16_t c = trimmed[i];
+      if (c >= u'A' && c <= u'Z') {
+        c += u'a' - u'A';
+      }
+      if (c != word[i]) {
+        equal = false;
+        break;
+      }
+    }
+    if (equal && (trimmed.size() == word.size() ||
+                  !IsWordCharacter(trimmed[word.size()]))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool LooksLikeURL(std::u16string_view input) {
+  const std::u16string_view trimmed =
+      base::TrimWhitespace(input, base::TRIM_ALL);
+  if (trimmed.empty() || trimmed.find_first_of(u" \t\r\n") !=
+                             std::u16string_view::npos) {
+    return false;
+  }
+  const std::string candidate = base::UTF16ToUTF8(trimmed);
+  if (candidate.find("://") != std::string::npos ||
+      candidate.starts_with("about:")) {
+    return GURL(candidate).is_valid();
+  }
+  const GURL inferred("https://" + candidate);
+  return inferred.is_valid() && inferred.host().find('.') != std::string::npos;
+}
+
+// This is a browser-owned website handoff. It does not invoke either ChatGPT
+// extension. The URL shape is the official ChatGPT search extension's public
+// search-provider template, and direct navigation was verified to submit.
+GURL ChatGPTSearchURL(std::u16string_view question) {
+  const std::string escaped = base::EscapeQueryParamValue(
+      base::UTF16ToUTF8(question), /*use_plus=*/false);
+  return GURL("https://chatgpt.com/?q=" + escaped +
+              "&hints=search&ref=ext");
+}
+
+class ArcCommandBarView : public views::View,
+                          public views::TextfieldController,
+                          public views::WidgetObserver {
+  METADATA_HEADER(ArcCommandBarView, views::View)
+
+ public:
+  ArcCommandBarView(BrowserWindowInterface* browser, int width)
+      : browser_(browser), width_(width) {
+    SetBackground(views::CreateRoundedRectBackground(ui::kColorSysSurface1,
+                                                     kCornerRadius));
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(14, 12)));
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 5));
+    textfield_ = AddChildView(std::make_unique<views::Textfield>());
+    textfield_->SetPlaceholderText(u"⌕  Search or Enter URL...");
+    textfield_->SetPreferredSize(gfx::Size(width_ - 24, 54));
+    textfield_->SetBackgroundColor(ui::kColorSysSurface1);
+    textfield_->SetTextColorId(ui::kColorSysOnSurface);
+    textfield_->set_controller(this);
+    textfield_->GetViewAccessibility().SetName(u"Command palette");
+    auto* divider = AddChildView(std::make_unique<views::View>());
+    divider->SetPreferredSize(gfx::Size(width_ - 24, 1));
+    divider->SetBackground(
+        views::CreateSolidBackground(ui::kColorSysOutlineVariant));
+    results_container_ = AddChildView(std::make_unique<views::View>());
+    results_container_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 4));
+    for (int i = 0; i < kMaxResults; ++i) {
+      auto* row = results_container_->AddChildView(
+          std::make_unique<views::LabelButton>(
+              base::BindRepeating(&ArcCommandBarView::ActivateResult,
+                                  base::Unretained(this), i), u""));
+      row->SetPreferredSize(gfx::Size(width_ - 24, 44));
+      row->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      row->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, 13)));
+      row->SetVisible(false);
+      result_rows_.push_back(row);
+    }
+    destination_ = AddChildView(std::make_unique<views::Label>());
+    destination_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    destination_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(5, 13)));
+    destination_->SetEnabledColor(ui::kColorSysOnSurfaceVariant);
+    UpdateResults();
+    UpdateDestination();
+  }
+  ArcCommandBarView(const ArcCommandBarView&) = delete;
+  ArcCommandBarView& operator=(const ArcCommandBarView&) = delete;
+  ~ArcCommandBarView() override = default;
+
+  views::Textfield* textfield() { return textfield_; }
+
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override {
+    UpdateResults();
+    UpdateDestination();
+  }
+
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override {
+    if (key_event.type() != ui::EventType::kKeyPressed) {
+      return false;
+    }
+    if (key_event.key_code() == ui::VKEY_ESCAPE) {
+      GetWidget()->Close();
+      return true;
+    }
+    if (key_event.key_code() == ui::VKEY_TAB) {
+      if (key_event.IsShiftDown()) {
+        return false;
+      }
+      explicit_chatgpt_ = !ShouldAskChatGPT();
+      UpdateDestination();
+      return true;
+    }
+    if (key_event.key_code() == ui::VKEY_DOWN && !results_.empty()) {
+      selected_result_ = (selected_result_ + 1) % results_.size();
+      UpdateResultAppearance();
+      return true;
+    }
+    if (key_event.key_code() == ui::VKEY_UP && !results_.empty()) {
+      selected_result_ =
+          (selected_result_ + results_.size() - 1) % results_.size();
+      UpdateResultAppearance();
+      return true;
+    }
+    if (key_event.key_code() == ui::VKEY_RETURN) {
+      if (selected_result_ >= 0) {
+        ActivateResult(selected_result_);
+        return true;
+      }
+      Submit(sender->GetText());
+      return true;
+    }
+    return false;
+  }
+
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override {
+    if (!active) {
+      widget->RemoveObserver(this);
+      widget->Close();
+    }
+  }
+
+ private:
+  struct Result {
+    enum class Kind { kTab, kCommand } kind;
+    int value;
+    std::u16string label;
+  };
+
+  void UpdateResults() {
+    results_.clear();
+    const std::u16string query = base::ToLowerASCII(
+        std::u16string(base::TrimWhitespace(textfield_->GetText(),
+                                            base::TRIM_ALL)));
+    TabStripModel* tabs = browser_->GetTabStripModel();
+    if (tabs) {
+      for (int i = 0; i < tabs->count() &&
+                      results_.size() < kMaxResults; ++i) {
+        content::WebContents* contents = tabs->GetWebContentsAt(i);
+        const std::u16string title = contents->GetTitle();
+        const std::u16string url =
+            base::UTF8ToUTF16(contents->GetVisibleURL().spec());
+        if (!query.empty() &&
+            (base::ToLowerASCII(title).find(query) != std::u16string::npos ||
+             base::ToLowerASCII(url).find(query) != std::u16string::npos)) {
+          results_.push_back({Result::Kind::kTab, i, u"Tab  ·  " + title});
+        }
+      }
+    }
+    constexpr struct {
+      std::u16string_view label;
+      int command;
+    } commands[] = {{u"New window", IDC_NEW_WINDOW},
+                    {u"History", IDC_SHOW_HISTORY},
+                    {u"Downloads", IDC_SHOW_DOWNLOADS}};
+    for (const auto& command : commands) {
+      if (results_.size() == kMaxResults) {
+        break;
+      }
+      if (query.empty() ||
+          base::ToLowerASCII(command.label).find(query) !=
+              std::u16string::npos) {
+        results_.push_back({Result::Kind::kCommand, command.command,
+                            u"Action  ·  " + std::u16string(command.label)});
+      }
+    }
+    selected_result_ = results_.empty() ? -1 : 0;
+    for (size_t i = 0; i < result_rows_.size(); ++i) {
+      result_rows_[i]->SetVisible(i < results_.size());
+      if (i < results_.size()) {
+        result_rows_[i]->SetText(results_[i].label);
+      }
+    }
+    UpdateResultAppearance();
+    if (GetWidget()) {
+      GetWidget()->SetSize(GetPreferredSize());
+    }
+  }
+
+  void UpdateResultAppearance() {
+    for (size_t i = 0; i < results_.size(); ++i) {
+      const bool selected = static_cast<int>(i) == selected_result_;
+      result_rows_[i]->SetBackground(views::CreateRoundedRectBackground(
+          selected ? ui::kColorSysPrimaryContainer : ui::kColorSysSurface1,
+          8));
+      result_rows_[i]->SetEnabledTextColors(
+          selected ? ui::kColorSysOnPrimaryContainer
+                   : ui::kColorSysOnSurface);
+    }
+  }
+
+  void ActivateResult(int index) {
+    if (index < 0 || static_cast<size_t>(index) >= results_.size()) {
+      return;
+    }
+    const Result result = results_[index];
+    GetWidget()->Close();
+    if (result.kind == Result::Kind::kTab) {
+      browser_->GetTabStripModel()->ActivateTabAt(result.value);
+    } else {
+      chrome::ExecuteCommand(browser_, result.value);
+    }
+  }
+
+  bool ShouldAskChatGPT() const {
+    if (explicit_chatgpt_.has_value()) {
+      return *explicit_chatgpt_;
+    }
+    return !browser_->GetProfile()->IsOffTheRecord() &&
+           browser_->GetProfile()->GetPrefs()->GetBoolean(
+               prefs::kHeliumArcQuestionRouting) &&
+           LooksLikeQuestion(textfield_->GetText());
+  }
+
+  void UpdateDestination() {
+    if (LooksLikeURL(textfield_->GetText())) {
+      destination_->SetText(u"Open URL");
+    } else {
+      destination_->SetText(ShouldAskChatGPT()
+                                ? u"Ask ChatGPT · Tab to search"
+                                : u"Search default engine · Tab to ask ChatGPT");
+    }
+  }
+
+  void Submit(const std::u16string& text) {
+    const std::u16string trimmed(base::TrimWhitespace(text, base::TRIM_ALL));
+    if (trimmed.empty()) {
+      return;
+    }
+    AutocompleteMatch match;
+    AutocompleteClassifierFactory::GetForProfile(browser_->GetProfile())
+        ->Classify(trimmed, /*in_keyword_mode=*/false,
+                   /*allow_exact_keyword_match=*/true,
+                   metrics::OmniboxEventProto::INVALID_SPEC, &match, nullptr);
+    if (!match.destination_url.is_valid()) {
+      return;
+    }
+    const bool is_url = !AutocompleteMatch::IsSearchType(match.type);
+    const GURL destination =
+        !is_url && ShouldAskChatGPT() ? ChatGPTSearchURL(trimmed)
+                                     : match.destination_url;
+    if (!destination.is_valid()) {
+      return;
+    }
+    NavigateParams params(browser_.get(), destination,
+                          ui::PAGE_TRANSITION_TYPED);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    GetWidget()->Close();
+    Navigate(&params);
+  }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  const int width_;
+  raw_ptr<views::Textfield> textfield_ = nullptr;
+  raw_ptr<views::Label> destination_ = nullptr;
+  raw_ptr<views::View> results_container_ = nullptr;
+  std::vector<raw_ptr<views::LabelButton>> result_rows_;
+  std::vector<Result> results_;
+  int selected_result_ = -1;
+  std::optional<bool> explicit_chatgpt_;
+};
+
+BEGIN_METADATA(ArcCommandBarView)
+END_METADATA
+
+}  // namespace
+
+namespace helium {
+
+bool ShowArcCommandBar(BrowserWindowInterface* browser) {
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  views::Widget* parent = browser_view ? browser_view->GetWidget() : nullptr;
+  if (!parent || !browser_view->multi_contents_view()) {
+    return false;
+  }
+  const gfx::Rect page =
+      browser_view->multi_contents_view()->GetBoundsInScreen();
+  auto contents = std::make_unique<ArcCommandBarView>(
+      browser, std::min(kBarWidth, std::max(260, page.width() - 32)));
+  ArcCommandBarView* bar = contents.get();
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_POPUP);
+  params.parent = parent->GetNativeView();
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kDrop;
+  params.rounded_corners = gfx::RoundedCornersF(kCornerRadius);
+  params.activatable = views::Widget::InitParams::Activatable::kYes;
+  params.name = "ArcCommandBar";
+  const gfx::Size size = bar->GetPreferredSize();
+  params.bounds = gfx::Rect(page.CenterPoint().x() - size.width() / 2,
+                            page.y() + page.height() / 4, size.width(),
+                            size.height());
+  auto* widget = new views::Widget();
+  params.ownership = views::Widget::InitParams::WIDGET_OWNS_NATIVE_WIDGET;
+  widget->Init(std::move(params));
+  widget->SetContentsView(std::move(contents));
+  widget->AddObserver(bar);
+  widget->Show();
+  widget->Activate();
+  bar->textfield()->RequestFocus();
+  return true;
+}
+
+}  // namespace helium
