+namespace helium {
+
+bool ShowArcCommandBar(BrowserWindowInterface* browser) {
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  views::Widget* parent = browser_view ? browser_view->GetWidget() : nullptr;
+  if (!parent || !browser_view->multi_contents_view()) {
+    return false;
+  }
+  auto contents = std::make_unique<ArcCommandBarView>(browser);
+  ArcCommandBarView* bar = contents.get();
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_POPUP);
+  params.parent = parent->GetNativeView();
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kDrop;
+  params.rounded_corners = gfx::RoundedCornersF(kCornerRadius);
+  params.activatable = views::Widget::InitParams::Activatable::kYes;
+  params.name = "ArcCommandBar";
+  const gfx::Rect page =
+      browser_view->multi_contents_view()->GetBoundsInScreen();
+  const gfx::Size size = bar->GetPreferredSize();
+  params.bounds = gfx::Rect(page.CenterPoint().x() - size.width() / 2,
+                            page.y() + page.height() / 4, size.width(),
+                            size.height());
+  auto* widget = new views::Widget();
+  params.ownership = views::Widget::InitParams::WIDGET_OWNS_NATIVE_WIDGET;
+  widget->Init(std::move(params));
+  widget->SetContentsView(std::move(contents));
+  widget->AddObserver(bar);
+  widget->Show();
+  widget->Activate();
+  bar->textfield()->RequestFocus();
+  return true;
+}
+
+}  // namespace helium
