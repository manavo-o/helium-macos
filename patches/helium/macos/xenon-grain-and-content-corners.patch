@@ -99,0 +101,10 @@
+  void SetContentCornerRadii(const gfx::RoundedCornersF& radii) {
+    if (content_radii_ == radii) return;
+    content_radii_ = radii;
+    SetNativeViewCornerRadii(radii);
+    UpdateNativeClip();
+  }
+  void Layout(PassKey) override {
+    LayoutSuperclass<views::NativeViewHost>(this);
+    UpdateNativeClip();
+  }
@@ -110,0 +122,48 @@
+  void UpdateNativeClip() {
+    NSView* view = host_.view;
+    if (content_radii_.IsEmpty()) {
+      view.layer.mask = nil;
+      return;
+    }
+    view.wantsLayer = YES;
+    if (view.layer.mask == content_mask_ && content_mask_ &&
+        NSEqualRects(content_mask_.frame, view.bounds) &&
+        mask_radii_ == content_radii_) {
+      return;
+    }
+    const CGFloat w = NSWidth(view.bounds);
+    const CGFloat h = NSHeight(view.bounds);
+    const CGFloat limit = std::min(w, h) / 2;
+    const CGFloat tl = std::min<CGFloat>(content_radii_.upper_left(), limit);
+    const CGFloat tr = std::min<CGFloat>(content_radii_.upper_right(), limit);
+    const CGFloat br = std::min<CGFloat>(content_radii_.lower_right(), limit);
+    const CGFloat bl = std::min<CGFloat>(content_radii_.lower_left(), limit);
+    CGMutablePathRef path = CGPathCreateMutable();
+    CGPathMoveToPoint(path, nullptr, tl, 0);
+    CGPathAddLineToPoint(path, nullptr, w - tr, 0);
+    CGPathAddArcToPoint(path, nullptr, w, 0, w, tr, tr);
+    CGPathAddLineToPoint(path, nullptr, w, h - br);
+    CGPathAddArcToPoint(path, nullptr, w, h, w - br, h, br);
+    CGPathAddLineToPoint(path, nullptr, bl, h);
+    CGPathAddArcToPoint(path, nullptr, 0, h, 0, h - bl, bl);
+    CGPathAddLineToPoint(path, nullptr, 0, tl);
+    CGPathAddArcToPoint(path, nullptr, 0, 0, tl, 0, tl);
+    CGPathCloseSubpath(path);
+    const CGAffineTransform transform = view.isFlipped
+        ? CGAffineTransformIdentity : CGAffineTransformMake(1, 0, 0, -1, 0, h);
+    CGPathRef native_path = CGPathCreateCopyByTransformingPath(path, &transform);
+    if (!content_mask_) content_mask_ = [CAShapeLayer layer];
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    content_mask_.frame = view.bounds;
+    content_mask_.path = native_path;
+    mask_radii_ = content_radii_;
+    view.layer.mask = content_mask_;
+    [CATransaction commit];
+    CGPathRelease(native_path);
+    CGPathRelease(path);
+  }
+
+  gfx::RoundedCornersF content_radii_;
+  gfx::RoundedCornersF mask_radii_;
+  CAShapeLayer* __strong content_mask_;
@@ -176,0 +236,5 @@
