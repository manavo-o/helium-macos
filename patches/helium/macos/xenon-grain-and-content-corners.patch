Index: src/chrome/browser/ui/views/frame/multi_contents_view.cc
===================================================================
--- a/chrome/browser/ui/views/frame/multi_contents_view.cc
+++ b/chrome/browser/ui/views/frame/multi_contents_view.cc
@@ -650,0 +651,25 @@
+#if BUILDFLAG(IS_MAC)
+  const bool shared_page_frame = browser_view_->ShouldDrawVerticalTabStrip() &&
+                                 !IsInSplitView() && ShouldUseRoundedFrame();
+  const auto radii = shared_page_frame
+                         ? ThemedBackground::GetArcContentRadii(browser_view_)
+                         : gfx::RoundedCornersF();
+  // Clip the common ancestor too: rounding only WebContents leaves the
+  // outer page background square and misses other child surfaces (DevTools).
+  if (shared_page_frame) {
+    if (!arc_content_clip_layer_) {
+      SetPaintToLayer(ui::LAYER_NOT_DRAWN);
+      arc_content_clip_layer_ = true;
+    }
+    layer()->SetRoundedCornerRadius(radii);
+    layer()->SetIsFastRoundedCorner(true);
+  } else if (arc_content_clip_layer_) {
+    layer()->SetRoundedCornerRadius(gfx::RoundedCornersF());
+    layer()->SetIsFastRoundedCorner(false);
+    DestroyLayer();
+    arc_content_clip_layer_ = false;
+  }
+  // NativeViewHost needs its own native clip as well as the Views paint clip.
+  helium::SetArcHomeCornerRadii(arc_home_view_, radii);
+#endif
+
