+gfx::RoundedCornersF ThemedBackground::GetArcContentRadii(
+    const BrowserView* browser_view) {
+  // Square against the visible toolbar; round as it slides out of the way.
+  const float top = std::round(kArcContentCornerRadius *
+                              (1.f - browser_view->GetTopChromeRevealRatio()));
+  return gfx::RoundedCornersF(top, top, kArcContentCornerRadius,
+                             kArcContentCornerRadius);
+}
