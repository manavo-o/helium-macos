+TEST(ArcDefaultChatExtensionTest, UsesOfficialStoreAndAllowsOptOut) {
+  content::BrowserTaskEnvironment task_environment;
+  sync_preferences::TestingPrefServiceSyncable prefs;
+  ExtensionPrefs::RegisterProfilePrefs(prefs.registry());
+  scoped_refptr<TestInitialExternalExtensionLoader> loader =
+      base::MakeRefCounted<TestInitialExternalExtensionLoader>(prefs);
+  loader->StartLoading();
+  base::DictValue installed = loader->WaitForLoadFinished();
+  const std::string key =
+      MakePrefName("hehggadaopoacecdllhhajmbjkdcmajg",
+                   ExternalProviderImpl::kExternalUpdateUrl);
+  ASSERT_TRUE(installed.FindStringByDottedPath(key));
+  EXPECT_EQ(*installed.FindStringByDottedPath(key),
+            extension_urls::GetWebstoreUpdateUrl().spec());
+  prefs.SetList(pref_names::kInitialInstallList, base::ListValue());
+  loader->StartLoading();
+  EXPECT_TRUE(loader->WaitForLoadFinished().empty());
+}
+
