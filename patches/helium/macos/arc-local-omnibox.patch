+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_question_routing.h"
+
+#include <array>
+#include <string>
+
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/omnibox/browser/autocomplete_provider.h"
+#include "net/base/url_util.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+TEST(ArcQuestionRoutingTest, AllWordsCaseWhitespaceAndBoundaries) {
+  constexpr std::array<std::u16string_view, 27> words = {
+      u"who",   u"what", u"when", u"where", u"why",   u"how",    u"which",
+      u"whose", u"whom", u"is",   u"are",   u"am",    u"was",    u"were",
+      u"do",    u"does", u"did",  u"can",   u"could", u"should", u"would",
+      u"will",  u"has",  u"have", u"had",   u"may",   u"might"};
+  for (const auto word : words) {
+    SCOPED_TRACE(base::UTF16ToUTF8(word));
+    EXPECT_TRUE(IsArcQuestion(word));
+    EXPECT_TRUE(IsArcQuestion(base::ToUpperASCII(word) + u" something"));
+    EXPECT_TRUE(IsArcQuestion(u" \t" + std::u16string(word) + u"\n"));
+    EXPECT_TRUE(IsArcQuestion(std::u16string(word) + u": something"));
+    EXPECT_FALSE(IsArcQuestion(std::u16string(word) + u"thing"));
+    EXPECT_FALSE(IsArcQuestion(std::u16string(word) + u"_thing"));
+    EXPECT_FALSE(IsArcQuestion(std::u16string(word) + u"42"));
+  }
+}
+
+TEST(ArcQuestionRoutingTest, PunctuationUnicodeAndExpectedFalsePositives) {
+  EXPECT_TRUE(IsArcQuestion(u"please explain this?"));
+  EXPECT_TRUE(IsArcQuestion(u"?"));
+  EXPECT_TRUE(IsArcQuestion(u"is a plain prefix sufficient"));
+  EXPECT_TRUE(
+      IsArcQuestion(u"can opener"));  // Deliberately simple English rule.
+  for (const auto text :
+       {u"", u"  ", u"island", u"whoever", u"whaté", u"what\u0301",
+        u"what\U00010400", u"ordinary search"}) {
+    EXPECT_FALSE(IsArcQuestion(text));
+  }
+}
+
+TEST(ArcQuestionRoutingTest, NavigationOverridesAndPrivatePrecedence) {
+  for (const auto override : {std::optional<bool>(), std::optional<bool>(false),
+                              std::optional<bool>(true)}) {
+    EXPECT_EQ(ArcDestination::kNavigation,
+              ResolveArcFreeText(u"https://example.com/?who=what#how", true,
+                                 override, true, false));
+  }
+  EXPECT_EQ(ArcDestination::kSearch,
+            ResolveArcFreeText(u"Why?", false, false, true, false));
+  EXPECT_EQ(ArcDestination::kChatGPT,
+            ResolveArcFreeText(u"ordinary words", false, true, false, true));
+  EXPECT_EQ(ArcDestination::kSearch,
+            ResolveArcFreeText(u"WHY?", false, std::nullopt, true, true));
+  EXPECT_EQ(ArcDestination::kSearch,
+            ResolveArcFreeText(u"Why?", false, std::nullopt, false, false));
+  EXPECT_EQ(ArcDestination::kChatGPT,
+            ResolveArcFreeText(u"WhY?", false, std::nullopt, true, false));
+}
+
+TEST(ArcQuestionRoutingTest,
+     WebsiteEncodingRoundTripsWithoutParameterInjection) {
+  const std::u16string text =
+      u"Why café & tea?\nUnicode 世界 #fragment + = &q=other";
+  const GURL url = ChatGPTWebsiteProvider::BuildSubmissionURL(text);
+  ASSERT_TRUE(url.is_valid());
+  EXPECT_EQ("chatgpt.com", url.host());
+  EXPECT_FALSE(url.has_ref());
+  std::string question, hints, ref;
+  ASSERT_TRUE(net::GetValueForKeyInQuery(url, "q", &question));
+  ASSERT_TRUE(net::GetValueForKeyInQuery(url, "hints", &hints));
+  ASSERT_TRUE(net::GetValueForKeyInQuery(url, "ref", &ref));
+  EXPECT_EQ(base::UTF16ToUTF8(text), question);
+  EXPECT_EQ("search", hints);
+  EXPECT_EQ("ext", ref);
+}
+
+TEST(ArcQuestionRoutingTest, PaletteInstantiatesOnlyLocalProviders) {
+  using Type = AutocompleteProvider::Type;
+  const int allowed =
+      static_cast<int>(Type::kBookmark | Type::kBuiltin | Type::kHistoryQuick |
+                       Type::kHistoryUrl | Type::kShortcuts);
+  EXPECT_EQ(allowed, ArcLocalAutocompleteProviders());
+  const int remote = static_cast<int>(
+      Type::kSearch | Type::kZeroSuggest | Type::kDocument |
+      Type::kEnterpriseSearchAggregator | Type::kUnscopedExtension |
+      Type::kContextualSearch | Type::kHistoryEmbeddings);
+  EXPECT_EQ(0, ArcLocalAutocompleteProviders() & remote);
+}
+
