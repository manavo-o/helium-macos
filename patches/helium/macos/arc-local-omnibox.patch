@@ -0,0 +1,78 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_question_routing.h"
+
+#include <array>
+
+#include "base/strings/escape.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/omnibox/browser/autocomplete_provider.h"
+#include "third_party/icu/source/common/unicode/uchar.h"
+#include "third_party/icu/source/common/unicode/utf16.h"
+
+namespace helium {
+
+bool IsArcQuestion(std::u16string_view text) {
+  constexpr std::array<std::u16string_view, 27> words = {
+      u"who",   u"what", u"when", u"where", u"why",   u"how",    u"which",
+      u"whose", u"whom", u"is",   u"are",   u"am",    u"was",    u"were",
+      u"do",    u"does", u"did",  u"can",   u"could", u"should", u"would",
+      u"will",  u"has",  u"have", u"had",   u"may",   u"might"};
+  text = base::TrimWhitespace(text, base::TRIM_ALL);
+  if (text.find(u'?') != std::u16string_view::npos) {
+    return true;
+  }
+  for (const auto word : words) {
+    if (!base::StartsWith(text, word, base::CompareCase::INSENSITIVE_ASCII)) {
+      continue;
+    }
+    if (text.size() == word.size()) {
+      return true;
+    }
+    // Unicode letters, numbers and combining marks continue the word. This
+    // prevents prefixes such as "island", "whoever" and "whaté" matching.
+    UChar32 next = text[word.size()];
+    if (U16_IS_LEAD(next) && text.size() > word.size() + 1 &&
+        U16_IS_TRAIL(text[word.size() + 1])) {
+      next = U16_GET_SUPPLEMENTARY(next, text[word.size() + 1]);
+    }
+    const int8_t category = u_charType(next);
+    if (!u_isalnum(next) && next != u'_' && category != U_NON_SPACING_MARK &&
+        category != U_COMBINING_SPACING_MARK && category != U_ENCLOSING_MARK) {
+      return true;
+    }
+  }
+  return false;
+}
+
+ArcDestination ResolveArcFreeText(std::u16string_view text,
+                                  bool is_valid_url,
+                                  std::optional<bool> explicit_chatgpt,
+                                  bool automatic_enabled,
+                                  bool is_private) {
+  if (is_valid_url) {
+    return ArcDestination::kNavigation;
+  }
+  const bool ask = explicit_chatgpt.value_or(automatic_enabled && !is_private &&
+                                             IsArcQuestion(text));
+  return ask ? ArcDestination::kChatGPT : ArcDestination::kSearch;
+}
+
+GURL ChatGPTWebsiteProvider::BuildSubmissionURL(std::u16string_view question) {
+  return GURL("https://chatgpt.com/?q=" +
+              base::EscapeQueryParamValue(base::UTF16ToUTF8(question),
+                                          /*use_plus=*/false) +
+              "&hints=search&ref=ext");
+}
+
+int ArcLocalAutocompleteProviders() {
+  using Type = AutocompleteProvider::Type;
+  return static_cast<int>(Type::kBookmark | Type::kBuiltin |
+                          Type::kHistoryQuick | Type::kHistoryUrl |
+                          Type::kShortcuts);
+}
+
+}  // namespace helium
