+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_QUESTION_ROUTING_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_QUESTION_ROUTING_H_
+
+#include <optional>
+#include <string_view>
+
+#include "url/gurl.h"
+
+namespace helium {
+
+enum class ArcDestination { kNavigation, kSearch, kChatGPT };
+
+bool IsArcQuestion(std::u16string_view text);
+ArcDestination ResolveArcFreeText(std::u16string_view text,
+                                  bool is_valid_url,
+                                  std::optional<bool> explicit_chatgpt,
+                                  bool automatic_enabled,
+                                  bool is_private);
+
+// The official extension's public search-provider template, verified to submit
+// when navigated directly. This website handoff never invokes an extension.
+class ChatGPTWebsiteProvider {
+ public:
+  static GURL BuildSubmissionURL(std::u16string_view question);
+};
+
+// Only local omnibox providers are instantiated for the floating palette.
+int ArcLocalAutocompleteProviders();
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_QUESTION_ROUTING_H_
