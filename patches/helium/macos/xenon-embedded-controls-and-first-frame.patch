+          GetSideChromeDockRatio()};
+}
+
+float BrowserView::InterpolateZenChrome(float start, float target) const {
+  return std::lerp(start, target,
+                   static_cast<float>(zen_mode_layout_animation_.GetCurrentValue()));
+}
+
+void BrowserView::RetargetZenModeLayoutTransition(ZenChromeRatios target) {
+  if (zen_mode_layout_animation_.is_animating()) {
+    if (zen_top_chrome_animation_.GetCurrentValue() == target.top &&
+        zen_side_chrome_animation_.GetCurrentValue() == target.side &&
+        zen_side_dock_animation_.GetCurrentValue() == target.dock) {
+      return;
+    }
+    zen_mode_layout_start_ = GetDisplayedZenChromeRatios();
+    zen_mode_layout_animation_.Reset(0);
+    zen_top_chrome_animation_.Reset(target.top);
+    zen_side_chrome_animation_.Reset(target.side);
+    zen_side_dock_animation_.Reset(target.dock);
+    zen_mode_layout_animation_.Show();
+    return;
+  }
+  zen_top_chrome_animation_.Reset(target.top);
+  zen_side_chrome_animation_.Reset(target.side);
+  zen_side_dock_animation_.Reset(target.dock);
+}
+#endif
