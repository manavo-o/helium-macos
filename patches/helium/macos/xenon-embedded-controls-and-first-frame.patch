+- (void)layoutButtonsForSize:(NSSize)size
+                     stacked:(BOOL)stacked
+                 visibleRect:(NSRect)visibleRect {
+  if (!NSEqualSizes(_buttonLayoutSize, size) || _buttonsStacked != stacked) {
+    _buttonLayoutSize = size;
+    _buttonsStacked = stacked;
+    const bool rtl = _browserWindow.windowTitlebarLayoutDirection ==
+                     NSUserInterfaceLayoutDirectionRightToLeft;
+    const NSUInteger count = self.subviews.count;
+    for (NSUInteger i = 0; i < count; ++i) {
+      NSView* button = self.subviews[i];
+      NSRect frame = button.frame;
+      const CGFloat fraction = count > 1 ? static_cast<CGFloat>(i) / (count - 1)
+                                         : 0.5;
+      const CGFloat x = size.width - frame.size.width;
+      const CGFloat y = size.height - frame.size.height;
+      frame.origin = stacked ? NSMakePoint(x / 2, y * (1 - fraction))
+                             : NSMakePoint(x * (rtl ? 1 - fraction : fraction),
+                                           y / 2);
+      button.frame = frame;
+    }
+  }
+
+  if (NSEqualRects(_visibleControlRect, visibleRect)) {
+    return;
+  }
+  _visibleControlRect = visibleRect;
+  if (NSEqualRects(visibleRect, NSMakeRect(0, 0, size.width, size.height))) {
+    self.layer.mask = nil;
+    return;
+  }
+  self.wantsLayer = YES;
+  if (!_controlClip) {
+    _controlClip = [CAShapeLayer layer];
+  }
+  CGPathRef clip = CGPathCreateWithRect(NSRectToCGRect(visibleRect), nullptr);
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  _controlClip.frame = CGRectMake(0, 0, size.width, size.height);
+  _controlClip.path = clip;
+  self.layer.mask = _controlClip;
+  [CATransaction commit];
+  CGPathRelease(clip);
+}
