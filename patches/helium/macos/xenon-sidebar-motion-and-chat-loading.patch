+#if BUILDFLAG(IS_MAC)
+namespace {
+
+// The standard extension view still owns its renderer and loads normally. This
+// surface fills the space it would otherwise leave blank until its first load.
+class ChatLoadingView final : public views::View,
+                              public content::WebContentsObserver {
+ public:
+  explicit ChatLoadingView(SidePanelNativeView content) {
+    SetLayoutManager(std::make_unique<views::FillLayout>());
+    auto* status = AddChildView(std::make_unique<views::View>());
+    auto* layout = status->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(16), 8));
+    layout->set_main_axis_alignment(views::BoxLayout::MainAxisAlignment::kCenter);
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    status_ = status;
+    message_ = status->AddChildView(std::make_unique<views::Label>());
+    message_->SetMultiLine(true);
+    retry_ = status->AddChildView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(&ChatLoadingView::Retry, base::Unretained(this)),
+        u"Retry"));
+    auto* extension = views::AsViewClass<views::WebView>(content.get());
+    CHECK(extension);
+    extension_view_ = AddChildViewAt(std::move(content), 0);
+    Observe(extension->web_contents());
+    if (web_contents()->IsDocumentOnLoadCompletedInPrimaryMainFrame()) {
+      DidStopLoading();
+    } else {
+      StartLoading();
+    }
+  }
+
+  void RequestFocus() override {
+    if (extension_view_ && extension_view_->GetVisible()) {
+      extension_view_->RequestFocus();
+    } else if (retry_->GetVisible()) {
+      retry_->RequestFocus();
+    }
+  }
+
+ private:
+  void StartLoading() {
+    extension_view_->SetVisible(false);
+    message_->SetText(u"Loading Chat…");
+    retry_->SetVisible(false);
+    timeout_.Start(FROM_HERE, base::Seconds(20),
+                   base::BindOnce(&ChatLoadingView::ShowError,
+                                  base::Unretained(this)));
+  }
+
+  void Retry() {
+    if (!web_contents()) {
+      return;
+    }
+    StartLoading();
+    web_contents()->GetController().Reload(content::ReloadType::NORMAL,
+                                           /*check_for_repost=*/true);
+  }
+
+  void DidStopLoading() override {
+    const auto* committed =
+        web_contents()->GetController().GetLastCommittedEntry();
+    if (!committed || committed->GetPageType() == content::PAGE_TYPE_ERROR) {
+      extension_view_->SetVisible(false);
+      ShowError();
+      return;
+    }
+    timeout_.Stop();
+    Observe(nullptr);
+    status_->SetVisible(false);
+    extension_view_->SetVisible(true);
+  }
+
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override {
+    extension_view_->SetVisible(false);
+    ShowError();
+  }
+
+  void ShowError() {
+    timeout_.Stop();
+    message_->SetText(u"Chat couldn’t load.");
+    retry_->SetVisible(true);
+  }
+
+  raw_ptr<views::View> status_ = nullptr;
+  raw_ptr<views::Label> message_ = nullptr;
+  raw_ptr<views::MdTextButton> retry_ = nullptr;
+  raw_ptr<views::View> extension_view_ = nullptr;
+  base::OneShotTimer timeout_;
+};
+
