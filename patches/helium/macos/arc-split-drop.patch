 class MultiContentsViewBrowserTest
-    : public SplitViewBrowserTestMixin<InProcessBrowserTest> {};
+    : public SplitViewBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void VerifyPaneReplacement(MultiContentsDropTargetView::DropSide side) {
+    auto* model = browser()->GetTabStripModel();
+    chrome::AddTabAt(browser(), GURL(url::kAboutBlankURL), -1, true);
+    const auto split_id = model->AddToNewSplit(
+        {0}, split_tabs::SplitTabVisualData(),
+        split_tabs::SplitTabCreatedSource::kDragAndDropTab);
+    model->UpdateSplitRatio(split_id, 0.61);
+    const auto panes = model->GetSplitData(split_id)->ListTabs();
+    auto* displaced =
+        panes[side == MultiContentsDropTargetView::DropSide::START ? 0 : 1];
+    auto* retained =
+        panes[side == MultiContentsDropTargetView::DropSide::START ? 1 : 0];
+    auto* source = CreateBrowser(browser()->GetProfile());
+    auto* incoming = source->GetTabStripModel()->GetActiveWebContents();
+    MockDragController controller;
+    DragSessionData data;
+    data.source_view_index_ = 0;
+    EXPECT_CALL(controller, GetSessionData).WillOnce(ReturnRef(data));
+    EXPECT_CALL(controller, DetachTabAtForInsertion(0))
+        .WillOnce(
+            Return(source->GetTabStripModel()->DetachTabAtForInsertion(0)));
+    drop_target_view()->Show(
+        side, MultiContentsDropTargetView::DropTargetState::kFull,
+        MultiContentsDropTargetView::DragType::kTab);
+    multi_contents_view()->drop_target_controller().HandleTabDrop(controller);
+    ASSERT_EQ(3, model->count());
+    EXPECT_GE(model->GetIndexOfTab(displaced), 0);
+    EXPECT_FALSE(displaced->IsSplit());
+    EXPECT_TRUE(retained->IsSplit());
+    const auto after = model->GetSplitData(split_id)->ListTabs();
+    ASSERT_EQ(2u, after.size());
+    EXPECT_EQ(
+        incoming,
+        after[side == MultiContentsDropTargetView::DropSide::START ? 0 : 1]
+            ->GetContents());
+    EXPECT_DOUBLE_EQ(
+        0.61, model->GetSplitData(split_id)->visual_data()->split_ratio());
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(MultiContentsViewBrowserTest,
+                       ReplaceLeftPaneKeepsDisplacedTab) {
+  VerifyPaneReplacement(MultiContentsDropTargetView::DropSide::START);
+}
+IN_PROC_BROWSER_TEST_F(MultiContentsViewBrowserTest,
+                       ReplaceRightPaneKeepsDisplacedTab) {
+  VerifyPaneReplacement(MultiContentsDropTargetView::DropSide::END);
+}
 
