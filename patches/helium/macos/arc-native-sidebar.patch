+void ToolbarView::AttachArcSidebarControls(views::View* navigation,
+                                           views::View* header) {
+  if (!location_bar_view_ || display_mode_ != DisplayMode::kNormal ||
+      !arc_transferred_controls_.empty()) {
+    return;
+  }
+  // Save indices before moving any views. This also provides a safe ownership
+  // order during BrowserView teardown, regardless of child destruction order.
+  for (views::View* view : std::array<views::View*, 5>{
+           back_, forward_, reload_, home_, location_bar_view_}) {
+    if (view && view->parent() == this) {
+      arc_transferred_controls_.push_back({view, GetIndexOf(view).value()});
+    }
+  }
+  for (const auto& control : arc_transferred_controls_) {
+    auto owned = RemoveChildViewT(control.view.get());
+    (control.view == location_bar_view_ ? header : navigation)
+        ->AddChildView(std::move(owned));
+  }
+  // Keep extension controls and Chat aligned to the trailing toolbar edge.
+  arc_toolbar_spacer_ = AddChildViewAt(std::make_unique<views::View>(), 0);
+  arc_toolbar_spacer_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded)
+          .WithWeight(1));
+  if (vertical_tabs_collapse_button_) {
+    vertical_tabs_collapse_button_->SetVisible(false);
+  }
+  InvalidateLayout();
+}
+
+void ToolbarView::RestoreArcSidebarControls() {
+  if (arc_toolbar_spacer_) {
+    RemoveChildViewT(arc_toolbar_spacer_.get());
+    arc_toolbar_spacer_ = nullptr;
+  }
+  for (const auto& control : arc_transferred_controls_) {
+    auto* parent = control.view->parent();
+    if (parent && parent != this) {
+      auto owned = parent->RemoveChildViewT(control.view.get());
+      AddChildViewAt(std::move(owned),
+                     std::min(control.index, children().size()));
+    }
+  }
+  arc_transferred_controls_.clear();
+}
