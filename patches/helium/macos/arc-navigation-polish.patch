+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+#include "ui/views/bubble/bubble_dialog_delegate_view.h"
+#include <memory>
+#include "base/test/scoped_feature_list.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/ui_base_features.h"
+#include "ui/views/test/views_test_base.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
+
+namespace views {
+namespace {
+class ArcBubbleLifecycleTest : public ViewsTestBase {
+ public:
+  ArcBubbleLifecycleTest() {
+    features_.InitAndDisableFeature(::features::kThemeChangeOptimization);
+  }
+ private:
+  base::test::ScopedFeatureList features_;
+};
+class ThemeCounter : public WidgetObserver {
+ public:
+  void OnWidgetThemeChanged(Widget*) override { ++changes; }
+  int changes = 0;
+};
+TEST_F(ArcBubbleLifecycleTest, AnchorThemeChangeBeforeBubbleWidgetExists) {
+  auto anchor = std::make_unique<Widget>();
+  anchor->Init(CreateParamsForTestWidget(Widget::InitParams::CLIENT_OWNS_WIDGET,
+                                        Widget::InitParams::TYPE_WINDOW));
+  auto* contents = anchor->SetContentsView(std::make_unique<View>());
+  auto bubble = std::make_unique<BubbleDialogDelegate>(BubbleAnchor(contents), BubbleBorder::TOP_LEFT);
+  ASSERT_EQ(nullptr, bubble->GetWidget());
+  // This used to call Widget::ThemeChanged() with a null `this`, matching the
+  // supplied ARM64 crash at theme_update_scheduled_ (offset 0x338).
+  anchor->ThemeChanged();
+  EXPECT_EQ(nullptr, bubble->GetWidget());
+}
+TEST_F(ArcBubbleLifecycleTest, LiveBubbleStillReceivesThemeChanges) {
+  auto anchor = std::make_unique<Widget>();
+  anchor->Init(CreateParamsForTestWidget(Widget::InitParams::CLIENT_OWNS_WIDGET,
+                                        Widget::InitParams::TYPE_WINDOW));
+  auto* contents = anchor->SetContentsView(std::make_unique<View>());
+  auto delegate = std::make_unique<BubbleDialogDelegate>(BubbleAnchor(contents), BubbleBorder::TOP_LEFT);
+  auto* bubble = BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(delegate), Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET);
+  ThemeCounter observer;
+  bubble->AddObserver(&observer);
+  anchor->ThemeChanged();
+  EXPECT_GT(observer.changes, 0);
+  bubble->RemoveObserver(&observer);
+  bubble->CloseNow();
+}
+}  // namespace
+}  // namespace views
