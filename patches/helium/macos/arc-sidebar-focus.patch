   if (omnibox_focused) {
     reveal_top = true;
+    reveal_side = ShouldDrawVerticalTabStrip();
+  }
+  const auto* focused =
+      GetFocusManager() ? GetFocusManager()->GetFocusedView() : nullptr;
+  if (vertical_tab_strip_region_view_ && focused &&
+      vertical_tab_strip_region_view_->Contains(focused)) {
+    reveal_side = true;
