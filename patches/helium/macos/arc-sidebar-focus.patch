@@ -3055,6 +3075,11 @@ void BrowserView::SetFocusToLocationBar(
   // and can receive focus.  A synchronous layout is required so the toolbar
   // has non-zero height before FocusLocation runs.
   if (zen_mode_enabled_) {
+    // The actual omnibox is in the sidebar. Reveal it synchronously before
+    // focusing, including when the sidebar is temporarily hidden.
+    if (ShouldDrawVerticalTabStrip()) {
+      zen_side_chrome_animation_.Reset(1);
+    }
     RevealZenModeTopChromeImmediately();
