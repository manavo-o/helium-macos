+  }
+
+  void ExpectChatGPTNavigation(const GURL& source_url,
+                               int command,
+                               bool reuse_tab) {
+    auto* profile = browser()->GetProfile();
+    profile->GetPrefs()->SetBoolean(prefs::kHeliumArcQuestionRouting, true);
+    profile->GetPrefs()->SetBoolean(helium::kArcOnlineSuggestions, false);
+    search_test_utils::WaitForTemplateURLServiceToLoad(
+        TemplateURLServiceFactory::GetForProfile(profile));
+
+    chrome::AddTabAt(browser(), source_url, -1, true);
+    auto* tabs = browser()->GetTabStripModel();
+    auto* original = tabs->GetActiveWebContents();
+    const int count = tabs->count();
+    const GURL destination(
+        "https://chatgpt.com/?q=why%20caf%C3%A9%20%2B%20tea%20%26%20cake%3F"
+        "&hints=search&ref=ext");
+    std::atomic<int> requests{0};
+    content::URLLoaderInterceptor interceptor(base::BindLambdaForTesting(
+        [&](content::URLLoaderInterceptor::RequestParams* params) {
+          if (params->url_request.url.host() != "chatgpt.com") {
+            return false;
+          }
+          if (params->url_request.url == destination) {
+            ++requests;
+          }
+          content::URLLoaderInterceptor::WriteResponse(
+              "HTTP/1.1 200 OK\nContent-Type: text/html\n\n",
+              "<title>ChatGPT navigation test</title>", params->client.get());
+          return true;
+        }));
+
+    auto* palette = OpenPalette(command);
+    ASSERT_TRUE(palette);
+    helium::SetArcCommandBarInputForTesting(browser(),
+                                            u"why café + tea & cake?");
+    Key(palette, ui::VKEY_RETURN);
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return tabs->GetActiveWebContents()->GetLastCommittedURL() == destination;
+    }));
+
+    EXPECT_EQ(1, requests.load());
+    EXPECT_EQ(count + (reuse_tab ? 0 : 1), tabs->count());
+    auto* active = tabs->GetActiveWebContents();
+    EXPECT_EQ(reuse_tab, active == original);
+    EXPECT_EQ(content::Visibility::VISIBLE, active->GetVisibility());
+
+    auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+    EXPECT_TRUE(view->multi_contents_view()->GetActiveContentsView()->GetVisible());
+    for (auto* widget : views::Widget::GetAllOwnedWidgets(
+             view->GetWidget()->GetNativeView())) {
+      EXPECT_FALSE(widget->GetName() == "ArcCommandBar" && !widget->IsClosed());
+    }
   }
 };
 
