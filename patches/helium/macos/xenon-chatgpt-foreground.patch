+IN_PROC_BROWSER_TEST_F(ArcCommandBarBrowserTest, ChatGPTReusesHomeTab) {
+  ExpectChatGPTNavigation(GURL("chrome://newtab/"), IDC_NEW_TAB,
+                          /*reuse_tab=*/true);
+}
+
+IN_PROC_BROWSER_TEST_F(ArcCommandBarBrowserTest, ChatGPTOpensForegroundTab) {
+  ExpectChatGPTNavigation(GURL("about:blank"), IDC_NEW_TAB,
+                          /*reuse_tab=*/false);
+}
+
+IN_PROC_BROWSER_TEST_F(ArcCommandBarBrowserTest, ChatGPTEditsCurrentTab) {
+  ExpectChatGPTNavigation(GURL("about:blank"), IDC_FOCUS_LOCATION,
+                          /*reuse_tab=*/true);
+}
