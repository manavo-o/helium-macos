+- (void)showUpdateFoundWithAppcastItem:(SUAppcastItem*)item
+                               state:(SPUUserUpdateState*)state
+                               reply:(void (^)(SPUUserUpdateChoice))reply {
+  NSURL* release = item.infoURL;
+  if (item.informationOnlyUpdate &&
+      (![release.scheme isEqualToString:@"https"] ||
+       ![release.host isEqualToString:@"github.com"] ||
+       ![release.path hasPrefix:@"/manavo-o/helium-macos/releases/tag/xenon-"])) {
+    [observer_ updateStatus:VersionUpdater::FAILED
+              error_string:@"The Xenon release link could not be verified."];
+    reply(SPUUserUpdateChoiceDismiss);
+    return;
+  }
+
+  NSAlert* alert = [[NSAlert alloc] init];
+  alert.messageText = @"A Xenon update is available";
+  alert.informativeText = item.informationOnlyUpdate
+      ? @"Open the approved GitHub release to download the new disk image."
+      : @"Download the approved update and restart Xenon when it is ready.";
+  [alert addButtonWithTitle:item.informationOnlyUpdate ? @"Open GitHub" : @"Download"];
+  [alert addButtonWithTitle:@"Later"];
+  [observer_ updateStatus:VersionUpdater::UPDATED error_string:nil];
+  if ([alert runModal] != NSAlertFirstButtonReturn) {
+    reply(SPUUserUpdateChoiceDismiss);
+    return;
+  }
+  if (item.informationOnlyUpdate) {
+    [[NSWorkspace sharedWorkspace] openURL:release];
+    reply(SPUUserUpdateChoiceSkip);
+    return;
+  }
+  [observer_ updateStatus:VersionUpdater::UPDATING error_string:nil];
+  reply(SPUUserUpdateChoiceInstall);
+}
+
+- (void)showReadyToInstallAndRelaunch:
+    (void (^)(SPUUserUpdateChoice))reply {
+  NSAlert* alert = [[NSAlert alloc] init];
+  alert.messageText = @"Xenon is ready to update";
+  alert.informativeText = @"Install the update and relaunch Xenon now.";
+  [alert addButtonWithTitle:@"Install and Relaunch"];
+  [alert addButtonWithTitle:@"Cancel"];
+  if ([alert runModal] == NSAlertFirstButtonReturn) {
+    reply(SPUUserUpdateChoiceInstall);
+  } else {
+    [observer_ updateStatus:VersionUpdater::UPDATED error_string:nil];
+    reply(SPUUserUpdateChoiceSkip);
+  }
 }
 
